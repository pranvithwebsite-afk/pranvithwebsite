{
  "version": 2,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/assets/(.*\\.(png|jpg|jpeg|webp|gif|svg|ico))",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/asset-manifest.json",
      "dest": "/frontend/asset-manifest.json"
    },
    {
      "src": "/favicon.ico",
      "dest": "/frontend/favicon.ico"
    },
    {
      "src": "/favicon-32x32.png",
      "dest": "/frontend/favicon-32x32.png"
    },
    {
      "src": "/favicon-48x48.png",
      "dest": "/frontend/favicon-48x48.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/frontend/apple-touch-icon.png"
    },
    {
      "src": "/logo-512.png",
      "dest": "/frontend/logo-512.png"
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/manifest.json"
    },
    {
      "src": "/admin-manifest.json",
      "dest": "/frontend/admin-manifest.json"
    },
    {
      "src": "/admin-apple-touch-icon.png",
      "dest": "/frontend/admin-apple-touch-icon.png"
    },
    {
      "src": "/admin-icon-192.png",
      "dest": "/frontend/admin-icon-192.png"
    },
    {
      "src": "/admin-icon-512.png",
      "dest": "/frontend/admin-icon-512.png"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html",
      "headers": {
        "Cache-Control": "no-cache",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  ]
}
