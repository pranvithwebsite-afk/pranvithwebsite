# Database and CMS admin seeding. Use real values only in local untracked
# environment files or the Vercel dashboard; never commit credentials.
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=your_database_name
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_admin_password
DEFAULT_ADMIN_NAME=Super Admin

# Camera AI (server-side only; never use a VITE_/REACT_APP_ prefix for this key)
CAMERA_AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
CAMERA_AI_MODEL=gpt-5.6-luna
CAMERA_AI_MAX_HISTORY=10
CAMERA_AI_MAX_TOKENS=700
CAMERA_AI_TIMEOUT_SECONDS=25
CAMERA_AI_RATE_LIMIT_PER_MINUTE=12
# Use only for local testing; production must remain false.
CAMERA_AI_MOCK=false
